---
import Layout from "../layouts/Layout.astro";
import EcosystemMap from "../components/EcosystemMap.astro";
import EcosystemSegments from "../components/EcosystemSegments.astro";
import MetricHighlight from "../components/MetricHighlight.astro";
import { getCollection } from "astro:content";
import { formatSignalDate } from "../lib/content-signals";
import { isCloneActive } from "../lib/activity";

const clones = await getCollection("clones");
const activeClones = clones.filter((clone) => isCloneActive(clone, new Date()));
const lastUpdatedAt = clones.reduce(
    (latest: string, clone: any) =>
        clone.data.last_updated > latest ? clone.data.last_updated : latest,
    clones[0]?.data.last_updated ?? "",
);
---

<Layout
    title="The OpenClaw ecosystem map - ClawClones"
    description="Every tracked OpenClaw alternative on one map: sized by stars, coloured by language, then segmented by the axes that drive the decision."
>
    <section class="mx-auto max-w-7xl px-6 pt-20 pb-14 md:pt-28 md:pb-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-pale-slate-500">
            Ecosystem · {activeClones.length} tracked · updated {formatSignalDate(lastUpdatedAt)}
        </p>
        <h1 class="mt-7 font-semibold text-[40px] md:text-[72px] leading-[1.02] tracking-[-0.02em] max-w-4xl">
            The ClawVerse.
        </h1>
        <p class="mt-7 max-w-xl text-[17px] leading-relaxed text-pale-slate-400">
            Every tracked clone in one orbit map — sized by stars, coloured by
            language, ringed by scale. Hover a node for the summary, click it for the
            full profile.
        </p>
    </section>

    <EcosystemMap />

    <MetricHighlight />

    <EcosystemSegments />

    <section class="border-t hairline">
        <div class="mx-auto max-w-7xl px-6 py-14 md:py-20 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
            <div>
                <h2 class="eyebrow">Next</h2>
                <h3 class="mt-3 font-semibold text-[24px] md:text-[32px] tracking-[-0.01em] max-w-xl leading-tight">
                    The map shows the shape of the ecosystem. The index shows the numbers.
                </h3>
                <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-pale-slate-600 dark:text-pale-slate-400">
                    Sort by stars, memory or commit activity, narrow to what you need, then
                    send any two projects into a side-by-side comparison.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-3 shrink-0">
                <a href="/#clones" class="btn-primary">Open the index →</a>
                <a
                    href="/analysis"
                    class="border hairline px-5 py-2.5 text-[13px] font-medium rounded-sm text-pale-slate-600 dark:text-pale-slate-300 hover:text-ink dark:hover:text-white transition-colors duration-150"
                >
                    Full analysis
                </a>
            </div>
        </div>
    </section>
</Layout>
