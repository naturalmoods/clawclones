# Copy to `.env` and fill in what you need.
#
# Every provider is optional: when a key is missing the relevant script logs a
# warning and skips that source rather than failing the whole run. You can work
# on the frontend with no keys at all, since the generated content under
# `src/content/` and `src/data/` is committed.

# --- AI generation -----------------------------------------------------------
# Which provider the generation pipeline talks to: `nvidia` or `openrouter`.
AI_PROVIDER=nvidia

# Used when AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3

# Used when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest

# --- Data sources ------------------------------------------------------------
# Repository metadata, releases and commit activity. A classic or fine-grained
# token with public read access is enough; without one you hit the low
# unauthenticated GitHub rate limit almost immediately.
GITHUB_TOKEN=

# Brave Search, used for the per-clone web mention count.
BRAVE_API_KEY=

# Reddit needs no credentials: the fetcher reads the public search feed with a
# descriptive User-Agent.

# --- Cloudflare analytics ----------------------------------------------------
# Only needed for `npm run fetch-analytics`. The token needs exactly one
# permission — Zone / Analytics / Read — scoped to the site's zone. The zone id
# is on the domain's Overview page in the Cloudflare dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Pipeline behaviour (all optional) ---------------------------------------
# Per-request ceiling for AI calls, in milliseconds. Defaults to 300000; raise
# it for reasoning models that think for a while before answering.
AI_REQUEST_TIMEOUT_MS=
# Comma-separated `owner/repo` list to refresh instead of the full set.
TARGET_REPOS=
# Set to `true` to let watchlist entries promote themselves once they clear the
# thresholds in `scripts/lib/config.ts`.
WATCHLIST_AUTO_PROMOTE=
# How stale a source may be before the partner feed reports it as degraded.
PARTNER_FEED_MAX_SOURCE_AGE_HOURS=

# --- Deployment only ---------------------------------------------------------
# `PARTNER_API_KEYS` is read by the Cloudflare Pages Function in
# `functions/api/partner-feed.ts`. Set it as a Pages environment variable, not
# here: a comma-separated list of accepted API keys.
